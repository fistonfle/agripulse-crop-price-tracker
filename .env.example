# Settings for docker compose. Copy this file to .env to change them:
#   cp .env.example .env        (Windows: copy .env.example .env)
# Without a .env file, docker-compose.yml uses these same values.
# (backend/.env is the one used when you run the API with npm instead.)

POSTGRES_USER=agripulse
POSTGRES_PASSWORD=agripulse
POSTGRES_DB=agripulse

# The port PostgreSQL uses on your computer. Change it only if 5433 is taken.
DB_PORT=5433

# Signs the login tokens. Use a long random string for a real deployment.
JWT_SECRET=local-development-secret
